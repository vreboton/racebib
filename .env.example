# Copy to .env for local Docker development. Replace every value before deployment.
MYSQL_DATABASE=racebib
MYSQL_USER=racebib_app
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
JWT_ISSUER=RaceBib
JWT_AUDIENCE=RaceBib.Clients
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-for-local-development
JWT_ACCESS_TOKEN_MINUTES=15
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
WEB_PORT=8080

# Optional: development-only initial administrator. Omit to skip user seeding.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional invitation email delivery. Without SMTP, the API returns a local-only invitation link in Development.
APPLICATION_BASE_URL=http://localhost:8080
INVITATION_EXPIRATION_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
