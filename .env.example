# Copy to .env for local Docker development. Replace every value before deployment.
MYSQL_DATABASE=racebib
MYSQL_USER=racebib_app
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
JWT_ISSUER=RaceBib
JWT_AUDIENCE=RaceBib.Clients
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-for-local-development
JWT_ACCESS_TOKEN_MINUTES=15
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
WEB_PORT=8080
