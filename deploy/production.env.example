# Copy to /opt/racebib/.env; chmod 600. Never source this file as shell code.
# Use hex secrets to avoid Compose and connection-string escaping issues.
MYSQL_DATABASE=racebib
MYSQL_USER=racebib_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SIGNING_KEY=
JWT_ISSUER=RaceBib
JWT_AUDIENCE=RaceBib.Clients
APPLICATION_BASE_URL=http://YOUR_EC2_PUBLIC_IP
# Disposable credentials/data only; host Nginx MUST enforce a tester allowlist.
# Normal access requires https and an HTTPS base URL.
DEPLOYMENT_ACCESS_MODE=restricted-http
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Pin a tested mysql:8.4 digest before first deployment. Never casually upgrade it.
MYSQL_IMAGE=
