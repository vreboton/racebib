{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeAddresses",
        "ec2:DescribeNatGateways",
        "ec2:DescribeSnapshots",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:GetConsoleOutput",
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Environment": "racebib-staging",
          "ec2:ResourceTag/ManagedBy": "racebib-rehearsal"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:ap-southeast-2:ACCOUNT_ID:stack/racebib-staging-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "racebib-staging",
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Temporary": "true"
        },
        "Null": {
          "cloudformation:ResourceTypes": "false"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::EC2::VPC",
            "AWS::EC2::Subnet",
            "AWS::EC2::InternetGateway",
            "AWS::EC2::VPCGatewayAttachment",
            "AWS::EC2::RouteTable",
            "AWS::EC2::Route",
            "AWS::EC2::SubnetRouteTableAssociation",
            "AWS::EC2::SecurityGroup",
            "AWS::EC2::Instance"
          ]
        }
      }
    },
    {
      "Sid": "TagOnlyNewStagingStacks",
      "Effect": "Allow",
      "Action": "cloudformation:TagResource",
      "Resource": "arn:aws:cloudformation:ap-southeast-2:ACCOUNT_ID:stack/racebib-staging-*/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:CreateAction": "CreateStack",
          "aws:RequestTag/Environment": "racebib-staging",
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Temporary": "true"
        },
        "StringLike": {
          "aws:RequestTag/StageRun": "????????????????????????????????"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Environment",
            "StageRun",
            "ManagedBy",
            "Temporary"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:ap-southeast-2:ACCOUNT_ID:stack/racebib-staging-*/*"
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:DeleteStack",
      "Resource": "arn:aws:cloudformation:ap-southeast-2:ACCOUNT_ID:stack/racebib-staging-*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "racebib-staging",
          "aws:ResourceTag/ManagedBy": "racebib-rehearsal",
          "aws:ResourceTag/Temporary": "true"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteVpc"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Environment": "racebib-staging",
          "ec2:ResourceTag/ManagedBy": "racebib-rehearsal"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-southeast-2::image/AMI_ID"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Environment": "racebib-staging",
          "ec2:ResourceTag/ManagedBy": "racebib-rehearsal"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "racebib-staging",
          "aws:RequestTag/ManagedBy": "racebib-rehearsal"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:network-interface/*"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Environment": "racebib-staging",
          "ec2:ResourceTag/ManagedBy": "racebib-rehearsal"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Environment": "racebib-staging",
          "ec2:ResourceTag/ManagedBy": "racebib-rehearsal"
        }
      }
    },
    {
      "Action": "ec2:CreateVpc",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Environment": "racebib-staging"
        }
      },
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:vpc/*",
      "Effect": "Allow"
    },
    {
      "Action": "ec2:CreateInternetGateway",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Environment": "racebib-staging"
        }
      },
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:internet-gateway/*",
      "Effect": "Allow"
    },
    {
      "Action": "ec2:CreateSubnet",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Environment": "racebib-staging"
        }
      },
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:subnet/*",
      "Effect": "Allow"
    },
    {
      "Action": "ec2:CreateRouteTable",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Environment": "racebib-staging"
        }
      },
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:route-table/*",
      "Effect": "Allow"
    },
    {
      "Action": "ec2:CreateSecurityGroup",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "racebib-rehearsal",
          "aws:RequestTag/Environment": "racebib-staging"
        }
      },
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:security-group/*",
      "Effect": "Allow"
    },
    {
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "racebib-rehearsal",
          "ec2:ResourceTag/Environment": "racebib-staging"
        }
      },
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:vpc/*",
      "Effect": "Allow"
    }
  ]
}
